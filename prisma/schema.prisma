
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Board {
  id          String   @id @default(cuid())
  title       String
  orgId       String
  authorId    String
  authorName  String
  imageUrl    String
  templateId  String?
  backgroundPattern String?
  colorTheme  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  favorites   UserFavorite[]

  @@index([orgId])
  @@index([authorId])
}

model UserFavorite {
  id        String   @id @default(cuid())
  orgId     String
  userId    String
  boardId   String
  createdAt DateTime @default(now())

  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@unique([userId, boardId, orgId])
  @@index([boardId])
  @@index([userId, orgId])
  @@index([userId, boardId])
}

model Template {
  id        String   @id @default(cuid())
  name      String
  thumbnail String
  snapshot  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}
